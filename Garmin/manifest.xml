<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="http://www.garmin.com/xml/connectiq"
             id="com.claire.stress"
             name="Stress"
             type="app"
             version="1.0.0"
             minSdkVersion="8.0.0"
             maxSdkVersion="8.3.0"
             targetSdkVersion="8.3.0">

    <!-- Device support -->
    <devices>
        <device id="fr265" />
    </devices>

    <!-- App resources -->
    <resources>
        <!-- Link to external strings file -->
        <strings src="Resources/Strings/strings.xml" />

        <!-- Language support -->
        <languages>
            <language>en-US</language>
        </languages>
    </resources>

    <!-- App icons -->
    <icons>
        <icon src="Resources/images/icon.png" />
    </icons>

    <!-- Permissions (needed if accessing HRV/heart rate sensors) -->
    <permissions>
        <permission>ACTIVITY_TRACKER</permission>
        <permission>SENSOR_HEARTRATE</permission>
    </permissions>

</application>
