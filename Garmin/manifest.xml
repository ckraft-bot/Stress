<?xml version="1.0" encoding="UTF-8"?>
<Project name="StressApp" platform="iOS + watchOS" version="1.0">
  <Description>
    Manifest describing the structure of the StressApp project for iOS and watchOS,
    including shared Swift files and WatchKit components.
  </Description>

  <Targets>
    <Target
      name="StressApp"
      platform="iOS"
      deployment="15.0"
      bundle="com.claire.stressapp" />
      
    <Target
      name="StressApp WatchKit App"
      platform="watchOS"
      deployment="9.0"
      bundle="com.claire.stressapp.watch" />
  </Targets>

  <Shared>
    <Models>
      <File name="HRVSample.swift" />
      <File name="StressDetector.swift" />
    </Models>

    <Exercises>
      <File name="FiveFourThreeTwoOne.swift" />
      <File name="OneByThirty.swift" />
      <File name="FourByFour.swift" />
      <File name="Categorize.swift" />
      <File name="TouchGrass.swift" />
      <File name="ExerciseData.swift" />
    </Exercises>

    <Views>
      <File name="StressView.swift" />
      <File name="ExercisesMenuView.swift" />
      
      <Components>
        <File name="Countdown.swift" />
        <File name="ProgressCircle.swift" />
        <File name="Square.swift" />
      </Components>
    </Views>
  </Shared>

  <WatchKitApp>
    <File name="InterfaceController.swift" />
    <File name="WatchMenuView.swift" />
    
    <Folder name="Watch App Scenes" />
  </WatchKitApp>
</Project>
